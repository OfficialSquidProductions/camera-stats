<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deliberately no network, camera, microphone or broad storage permission. -->
    <application android:label="Shot Reporter" android:icon="@drawable/app_icon" android:allowBackup="false" android:supportsRtl="true" android:theme="@style/CameraStatsTheme">
        <activity android:name=".android.MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
